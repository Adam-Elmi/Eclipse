/* ###################
   The Eclipse launcher: a centered box like an editor's command palette, dark glass with a rose
   edge. A search field on top, then the list; the selected row is a rose → plum glow.
   Colors from colors.rasi (theme/generate.sh)
   ################### */
@import "colors.rasi"

* {
    background-color: transparent;
    text-color: @ink;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 560px;
    location: center;
    anchor: center;
    background-color: transparent;
    background-image: linear-gradient(to bottom, rgba(28, 25, 36, 0.86), rgba(15, 13, 20, 0.90));
    border: 1px solid;
    border-color: rgba(240, 101, 149, 0.45);
    border-radius: 12px;
}

mainbox {
    padding: 8px;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 8px 10px;
    margin: 0 0 6px 0;
    background-color: @header;
    border: 1px solid;
    border-color: @line;
    border-radius: 8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    margin: 0 10px 0 0;
}

entry {
    placeholder: "Search…";
    placeholder-color: @faint;
    cursor: text;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: true;
    scrollbar: false;
}

element {
    padding: 7px 10px;
    spacing: 10px;
    border-radius: 8px;
    children: [ element-icon, element-text ];
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
}

element selected.normal {
    background-image: linear-gradient(to right, rgba(240, 101, 149, 0.30), rgba(157, 78, 221, 0.12));
    border: 0 0 0 2px;
    border-color: @accent;
}

element-icon {
    size: 22px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    highlight: bold #f06595;
}

element selected.normal element-text {
    text-color: @ink;
}
